# Relaxation of a network built by gusev_build (LAMMPS 30 Sep 2026 or newer, MOLECULE package).
# The strands are Brownian bridges without excluded volume, so beads overlap and bond lengths
# scatter. A soft repulsion is ramped up first under capped displacements (push-off); then the
# bead-spring model of example_2 is switched on, shifted Lennard-Jones beads (cutoff 2.5) and
# harmonic bonds (K = 1000, r0 = 1), relaxed again under capped displacements and equilibrated
# with Langevin dynamics at T = 1. The network is already linked, so no end-linking run follows;
# its open ends and sites keep the types `end` and `xlink` of example_2.
#
# LAMMPS warns about inconsistent image flags: a strand linked to a periodic image of its
# cross-linker is bonded across the box, and a network that spans the box cannot be unwrapped
# consistently (the same holds after end-linking in example_2). Bonds use the minimum image, so
# the warning is harmless.
#
#   lmp -in in.relax -var data config.lmp      (in the directory written by gusev_build)
#
# Writes relax/after_push.lmp, relax/after_relax.lmp and relax/after_equil.lmp.

variable        data index config.lmp            # data file written by gusev_build
variable        seed index 241205                # random seed for velocities and thermostat
variable        push_steps index 20000           # soft push-off
variable        relax_steps index 10000          # capped-displacement relaxation of the full model
variable        equil_steps index 100000         # equilibration
variable        ref_t equal 1.0

units           lj
atom_style      molecular
boundary        p p p
read_data       ${data}

special_bonds   lj 0.0 1.0 1.0
timestep        0.005
shell           mkdir relax
compute         bonds all bond/local dist
compute         longest all reduce max c_bonds inputs local
thermo_style    custom step temp pe ebond epair c_longest
thermo          1000

#------------------------------------------------------------#
# Push-off: soft repulsion ramped up, weak bonds, capped moves
#------------------------------------------------------------#
bond_style      harmonic
bond_coeff      1 100.0 1.0
comm_modify     cutoff 4.0                       # the Gaussian bonds are longer than the soft cutoff
pair_style      soft 1.122462
pair_coeff      * * 0.0
variable        prefactor equal ramp(0,100)
fix             push all adapt 1 pair soft a * * v_prefactor
fix             1 all nve/limit 0.05
fix             2 all langevin ${ref_t} ${ref_t} 1.0 ${seed}
run             ${push_steps}
write_data      relax/after_push.lmp nocoeff
unfix           push
unfix           2
unfix           1
comm_modify     cutoff 0.0                       # back to the default, the pair cutoff

#------------------------------------------------------------#
# The bead-spring model of example_2, relaxed under capped moves
#------------------------------------------------------------#
bond_coeff      1 1000.0 1.0
pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      * * 1.0 1.0 2.5
fix             1 all nve/limit 0.1
fix             2 all langevin ${ref_t} ${ref_t} 1.0 $(v_seed+1)
run             ${relax_steps}
write_data      relax/after_relax.lmp nocoeff
unfix           2
unfix           1

#------------------------------------------------------------#
# Equilibration
#------------------------------------------------------------#
reset_timestep  0
velocity        all create ${ref_t} $(v_seed+2) mom yes rot no
fix             1 all nve
fix             2 all langevin ${ref_t} ${ref_t} 10.0 $(v_seed+3)
run             ${equil_steps}
write_data      relax/after_equil.lmp nocoeff
unfix           2
unfix           1

print           "relaxation done: longest bond $(c_longest:%.4f), pair energy per atom $(epair:%.4f)"
